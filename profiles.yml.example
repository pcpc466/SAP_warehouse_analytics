# This file is only needed for LOCAL dbt-core runs (dbt CLI on your laptop).
# If you're using dbt Cloud, you enter these same values directly in the
# dbt Cloud UI under Deploy > Connections -- you never upload this file.
#
# Local setup: copy this to ~/.dbt/profiles.yml and fill in your values.

sap_dwh:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: your_account_identifier      # e.g. xy12345.us-east-1
      user: your_username
      password: your_password               # or use key-pair/SSO in dbt Cloud
      role: your_role
      database: SAP_DB
      warehouse: SAP_WH
      schema: DBT_DEV                       # dbt writes here, not directly to STAGING/ANALYTICS
      threads: 4
